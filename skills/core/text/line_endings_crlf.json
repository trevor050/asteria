    ".ass",
    ".ssa",
    ".sbv",
    ".tex",
    ".rst",
    ".toml",
    ".env",
    ".properties",
    ".sql",
    ".js",
    ".ts",
    ".css",
    ".go",
    ".py",
    ".java",
    ".c",
    ".h",
    ".cpp",
    ".cs",
    ".rb",
    ".php",
    ".sh",
    ".bat",
    ".ps1"
  ],
  "outputType": "",
  "params": [],
