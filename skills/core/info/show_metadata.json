{
  "id": "show_metadata",
  "name": "Show Metadata",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": [
    "exif",
    "info",
    "details",
    "camera info",
    "where was this taken",
    "metadata"
  ],
  "category": "info",
  "description": "Write a .json file with size, format, bit depth, color profile and, when present, camera, lens, date, exposure and GPS position",
  "inputTypes": [
    "@image"
  ],
  "outputType": ".json",
  "params": [],
  "executor": {
    "type": "native",
    "handler": "info.metadata"
  },
  "permissions": [
    "files.read",
    "files.write",
    "files.temp"
  ],
  "dangerLevel": 0
}
