{
  "id": "image_difference",
  "name": "Image Difference",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": [
    "compare stats",
    "psnr",
    "ssim",
    "similarity",
    "how different",
    "image similarity"
  ],
  "category": "info",
  "description": "Pick two images of the same size; writes a .json with mean error, max difference, PSNR, % of pixels changed and SSIM",
  "inputTypes": [
    "@image"
  ],
  "outputType": ".json",
  "params": [],
  "executor": {
    "type": "native",
    "handler": "info.comparestats"
  },
  "permissions": [
    "files.read",
    "files.write",
    "files.temp"
  ],
  "dangerLevel": 0,
  "combine": true,
  "outputName": "difference"
}
