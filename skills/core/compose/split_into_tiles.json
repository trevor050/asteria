{
  "id": "split_into_tiles",
  "name": "Split into Tiles",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": [
    "slice",
    "split image",
    "instagram grid",
    "cut into pieces",
    "split into grid",
    "divide image",
    "carousel",
    "puzzle"
  ],
  "category": "compose",
  "description": "Cut the picture into a grid of separate files in a folder (2x2 by default)",
  "inputTypes": [
    "@image"
  ],
  "outputType": "folder",
  "params": [
    {
      "name": "grid",
      "label": "Grid",
      "type": "string",
      "default": "2x2",
      "presets": [
        "2x2",
        "3x3",
        "3x1",
        "1x3",
        "4x4"
      ],
      "hint": "3x3 = columns x rows · 3x1 = three across (Instagram) · tiles cover the picture exactly"
    }
  ],
  "executor": {
    "type": "native",
    "handler": "compose.split"
  },
  "permissions": [
    "files.read",
    "files.write",
    "files.temp"
  ],
  "dangerLevel": 0
}
