{
  "id": "remove_background_color",
  "name": "Remove Background Colour",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": [
    "transparent background",
    "knock out",
    "chroma key",
    "remove white background",
    "remove background",
    "remove background colour",
    "remove background color",
    "cut out background",
    "green screen"
  ],
  "category": "compose",
  "description": "Make the background colour transparent with a soft edge (finds it from the corners by default)",
  "inputTypes": [
    "@image"
  ],
  "outputType": ".png",
  "params": [
    {
      "name": "color",
      "label": "Colour",
      "type": "string",
      "default": "auto",
      "presets": [
        "auto",
        "white",
        "black",
        "#00ff00",
        "#0000ff"
      ],
      "hint": "auto = most common corner colour · white · #00ff00 · fully clear within a small colour distance, fading out beyond it"
    }
  ],
  "executor": {
    "type": "native",
    "handler": "compose.removebg"
  },
  "permissions": [
    "files.read",
    "files.write",
    "files.temp"
  ],
  "dangerLevel": 0
}
