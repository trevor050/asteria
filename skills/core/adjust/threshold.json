{
  "id": "threshold",
  "name": "Threshold",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": ["binary", "pure black and white", "two color black white", "lineart", "line art", "bilevel", "halftone cutoff"],
  "category": "adjust",
  "description": "Turn every pixel pure black or pure white around a brightness cut-off (50% by default)",
  "inputTypes": ["@image"],
  "outputType": "",
  "params": [
    {
      "name": "level",
      "label": "Level",
      "type": "string",
      "default": "50",
      "presets": ["30", "40", "50", "60", "70"],
      "min": 0,
      "max": 100,
      "unit": "%",
      "hint": "50 = middle grey · lower = more white · higher = more black"
    }
  ],
  "executor": { "type": "native", "handler": "adjust.threshold" },
  "permissions": ["files.read", "files.write", "files.temp"],
  "dangerLevel": 0
}
