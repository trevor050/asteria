{
  "id": "exposure",
  "name": "Exposure",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": ["ev", "stops", "exposure compensation", "overexpose", "underexpose", "f-stops"],
  "category": "adjust",
  "icon": "aperture",
  "description": "Brighter or darker in camera stops",
  "inputTypes": ["@image"],
  "outputType": "",
  "params": [
    {
      "name": "stops",
      "label": "Stops",
