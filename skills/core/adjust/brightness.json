{
  "id": "brightness",
  "name": "Brightness",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": [
    "brighter",
    "darker",
    "lighten",
    "darken",
    "dim",
    "light"
  ],
  "category": "adjust",
  "icon": "sun",
  "priority": 6,
  "description": "Brighter, or darker with a minus",
  "inputTypes": [
    "@image"
