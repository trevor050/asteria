{
  "id": "cool",
  "name": "Cooler",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": ["cool", "cool down", "colder", "cold", "blue tone", "cool tone"],
  "category": "adjust",
  "description": "Cool the picture toward blue (-25 by default); the same scale as Temperature",
  "inputTypes": ["@image"],
  "outputType": "",
  "params": [
    {
      "name": "amount",
      "label": "Amount",
      "type": "string",
      "default": "-25",
      "presets": ["-15", "-25", "-50", "-80"],
      "min": -100,
      "max": 0,
      "unit": "",
      "hint": "-25 = a little cooler · -80 = icy"
    }
  ],
  "executor": { "type": "native", "handler": "adjust.temperature" },
  "permissions": ["files.read", "files.write", "files.temp"],
  "dangerLevel": 0
}
