{
  "id": "replace_color",
  "name": "Replace Color",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": ["change color", "change colour", "swap color", "swap colour", "recolor", "recolour", "color replace", "colour replace", "replace colour"],
  "category": "adjust",
  "icon": "replace",
  "description": "Swap one color for another",
  "inputTypes": ["@image"],
  "outputType": "",
  "params": [
    {
      "name": "colors",
