{
  "id": "gamma",
  "name": "Gamma",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": ["midtones", "mid tones", "midtone brightness", "lift midtones"],
  "category": "adjust",
  "description": "Brighten midtones without touching black and white (gamma 1.2 by default); below 1 darkens them",
  "inputTypes": ["@image", "@video"],
  "outputType": "",
  "params": [
    {
      "name": "gamma",
      "label": "Gamma",
      "type": "float",
      "default": 1.2,
      "presets": [0.6, 0.8, 1.2, 1.5, 2.2],
      "min": 0.1,
      "max": 5,
      "unit": "",
      "hint": "1.2 = brighter midtones · 0.8 = darker · 1 = unchanged"
    }
  ],
  "executor": { "type": "native", "handler": "adjust.gamma" },
  "permissions": ["files.read", "files.write", "files.temp"],
  "dangerLevel": 0
}
