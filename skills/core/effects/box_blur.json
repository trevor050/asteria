{
  "id": "box_blur",
  "name": "Box Blur",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": [
    "boxblur",
    "box",
    "average blur",
    "flat blur",
    "smooth"
  ],
  "category": "filter",
  "description": "Blur with an even square average (6px radius by default)",
  "inputTypes": [
    "@image",
    "@video"
  ],
  "outputType": "",
  "params": [
    {
      "name": "radius",
      "label": "Radius",
      "type": "string",
      "default": "6",
      "presets": [
        "3",
        "6",
        "12",
        "24"
      ],
      "min": 1,
      "max": 100,
      "unit": "px",
      "hint": "Radius in pixels: 6 = soft · 24 = heavy"
    }
  ],
  "executor": {
    "type": "native",
    "handler": "effect.boxblur"
  },
  "permissions": [
    "files.read",
    "files.write",
    "files.temp"
  ],
  "dangerLevel": 0
}
