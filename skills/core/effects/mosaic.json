{
  "id": "mosaic",
  "name": "Mosaic",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": [
    "tiles",
    "tile",
    "stained glass",
    "grout",
    "tiled"
  ],
  "category": "filter",
  "description": "Turn the picture into square tiles with thin grout lines (16px tiles by default)",
  "inputTypes": [
    "@image"
  ],
  "outputType": "",
  "params": [
    {
      "name": "size",
      "label": "Tile size",
      "type": "string",
      "default": "16",
      "presets": [
        "8",
        "16",
        "32",
        "64"
      ],
      "min": 4,
      "max": 200,
      "unit": "px",
      "hint": "Tile size in pixels"
    }
  ],
  "executor": {
    "type": "native",
    "handler": "effect.mosaic"
  },
  "permissions": [
    "files.read",
    "files.write",
    "files.temp"
  ],
  "dangerLevel": 0
}
