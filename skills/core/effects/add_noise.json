{
  "id": "add_noise",
  "name": "Add Noise",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": [
    "noise",
    "grainy",
    "static",
    "dirty",
    "random noise",
    "colour noise",
    "color noise"
  ],
  "category": "filter",
  "description": "Add colour noise over the picture (12 by default)",
  "inputTypes": [
    "@image",
    "@video"
  ],
  "outputType": "",
  "params": [
    {
      "name": "amount",
      "label": "Amount",
      "type": "string",
      "default": "12",
      "presets": [
        "6",
        "12",
        "25",
        "50"
      ],
      "min": 1,
      "max": 100,
      "hint": "12 = fine · 40 = heavy"
    }
  ],
  "executor": {
    "type": "native",
    "handler": "effect.noise"
  },
  "permissions": [
    "files.read",
    "files.write",
    "files.temp"
  ],
  "dangerLevel": 0
}
