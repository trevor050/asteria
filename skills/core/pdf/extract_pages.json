{
  "id": "extract_pages",
  "name": "Extract Pages",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": [
    "pick pages",
    "select pages",
    "keep pages",
    "pdf pages"
  ],
  "category": "pdf",
  "description": "Keep only the listed pages, in the order you type them",
  "inputTypes": [
    "@pdf"
  ],
  "outputType": ".pdf",
  "params": [
    {
      "name": "pages",
      "label": "Pages",
      "type": "string",
      "default": "1",
      "presets": [
        "1",
        "1-3",
        "2-"
      ],
      "hint": "1-3, 5, 8- (8 to the end)"
    }
  ],
  "executor": {
    "type": "native",
    "handler": "pdf.extract"
  },
  "permissions": [
    "files.read",
    "files.write",
    "files.temp"
  ],
  "dangerLevel": 0
}
