{
  "id": "convert_to_webp",
  "name": "Convert to WebP",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": [
    "webp",
    "to webp"
  ],
  "category": "convert",
  "priority": 6,
  "description": "Save images as WebP, usually much smaller than JPEG",
  "inputTypes": [
    "@image"
  ],
  "outputType": ".webp",
  "params": [
    {
      "name": "quality",
      "label": "Quality",
      "type": "int",
      "default": 85,
      "presets": [
        95,
        90,
        80,
        70,
        60
      ],
      "unit": "%",
      "min": 1,
      "max": 100
    }
  ],
  "executor": {
    "type": "native",
    "handler": "image.convert"
  },
  "permissions": [
    "files.read",
    "files.write",
    "files.temp"
  ],
  "dangerLevel": 0
}
