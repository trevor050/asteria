{
  "id": "compress",
  "name": "Compress Image",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": [
    "cmp",
    "compress",
    "reduce size",
    "smaller file"
  ],
  "category": "compress",
  "icon": "fold-vertical",
  "priority": 10,
  "description": "Smaller file at a lower quality",
  "inputTypes": [
    "@image"
  ],
  "outputType": "",
  "params": [
    {
      "name": "quality",
      "label": "Quality",
      "type": "int",
      "hint": "75 = good balance · 50 = smaller file · quality 1-100",
      "default": 75,
      "presets": [
        95,
        90,
        80,
        70,
        60
      ],
      "unit": "%",
      "min": 1,
      "max": 100
    }
  ],
  "executor": {
    "type": "native",
    "handler": "image.compress"
  },
  "permissions": [
    "files.read",
    "files.write",
    "files.temp"
  ],
  "dangerLevel": 0
}
