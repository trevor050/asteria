{
  "id": "blur",
  "name": "Blur",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": [
    "soften",
    "gaussian"
  ],
  "category": "filter",
  "icon": "cloud-fog",
  "priority": 6,
  "description": "Soft gaussian blur",
  "inputTypes": [
    "@image",
    "@video"
  ],
  "outputType": "",
  "params": [
    {
      "name": "radius",
      "label": "Radius",
      "type": "string",
      "hint": "0.5% = soft · 2% = heavy · or pixels like 6",
      "default": "0.5%",
      "presets": [
        "0.3%",
        "0.5%",
        "1%",
        "2%"
      ],
      "unit": "%",
      "min": 0.1,
      "max": 5
    }
  ],
  "executor": {
    "type": "native",
    "handler": "image.blur"
  },
  "permissions": [
    "files.read",
    "files.write",
    "files.temp"
  ],
  "dangerLevel": 0
}
