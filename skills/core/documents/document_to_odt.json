    ".docx",
    ".doc",
    ".rtf"
  ],
  "outputType": ".odt",
  "params": [],
  "executor": {
    "type": "native",
    "handler": "engine.libreoffice"
  },
  "requires": [
    "soffice"
  ],
  "permissions": [
    "files.read",
    "files.write",
    "files.temp",
    "tools.exec"
  ],
  "dangerLevel": 0
}
