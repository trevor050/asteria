{
  "id": "document_to_odt",
  "name": "OpenDocument text",
  "version": "1.0.0",
  "author": "asteria",
  "aliases": [
    "to odt",
    "docx to odt"
  ],
  "category": "document",
  "icon": "file-type",
  "description": "OpenDocument text from Word or RTF",
