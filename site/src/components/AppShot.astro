---
import { Image } from 'astro:assets'
import shot from '../../../docs/screenshot-dark.png'
---

<section class="app" aria-labelledby="app-title">
  <div class="wrap">
    <figure>
      <Image
        src={shot}
        widths={[640, 1000, 1400, 2000]}
        sizes="(min-width: 1260px) 1180px, calc(100vw - 2 * var(--gutter))"
        alt="Asteria with eight files: four space photos resized and converted to WebP, each showing its size before and after, two PDFs, a video and a JSON file, while trim 0:01-0:04 is typed in the command bar."
        loading="lazy"
        decoding="async"
        format="webp"
        quality={82}
      />
    </figure>
    <div class="copy">
      <h2 id="app-title">One window, one bar.</h2>
      <p class="lede">
        Drop files in and the likely next steps sit right above the bar, so most of the time you just click one. Type for
        anything else. When it looks right, <kbd>⌘↵</kbd> (<kbd>Ctrl ↵</kbd> on Windows) saves the results next to the
        originals.
      </p>
    </div>
  </div>
</section>

<style>
  .app {
    padding-top: 0;
  }
  .copy {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px clamp(24px, 5vw, 72px);
    align-items: start;
  }
  .copy .lede {
    max-width: 52ch;
  }
  figure {
    margin: 0 0 clamp(36px, 5vw, 64px);
  }
  figure :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: clamp(10px, 1.4vw, 18px);
    border: 1px solid var(--line-strong);
    box-shadow:
      0 40px 80px -40px rgb(0 0 0 / 0.9),
      0 2px 0 rgb(255 255 255 / 0.03) inset;
    background: var(--panel);
  }
  @media (max-width: 760px) {
    .copy {
      grid-template-columns: 1fr;
    }
  }
</style>
