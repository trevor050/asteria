---
import Base from '../layouts/Base.astro'
import Hero from '../components/Hero.astro'
import AppThrough from '../components/AppThrough.astro'
import Through from '../components/Through.astro'
import Finder from '../components/Finder.astro'
import Free from '../components/Free.astro'
import Download from '../components/Download.astro'
import { appDescription } from '../lib/seo'

const description = appDescription
---

<Base title="Asteria: a free file converter that never uploads your files" description={description} path="/">
  <Hero />
  <AppThrough />
  <Through />
  <Finder show="popular" />
  <Free />
  <Download />
</Base>
