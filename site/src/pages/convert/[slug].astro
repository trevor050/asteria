---
import Base from '../../layouts/Base.astro'
import FileGlyph from '../../components/FileGlyph.astro'
import DownloadButton from '../../components/DownloadButton.astro'
import { pagePairs, skills, platformLabel, type Pair } from '../../lib/data'

export function getStaticPaths() {
  return pagePairs.map((pair) => ({ params: { slug: pair.slug }, props: { pair } }))
}

const { pair } = Astro.props as { pair: Pair }
const F = pair.from.toUpperCase()
const T = pair.to.toUpperCase()
const skill = skills.find((s) => s.id === pair.skill.id)
const others = pair.others.filter((o) => o.id !== pair.skill.id)

const platforms = pair.verifiedOn.map(platformLabel)
const platformText = platforms.length > 1 ? `${platforms.slice(0, -1).join(', ')} and ${platforms.at(-1)}` : platforms[0]
const checkers = [...new Set(Object.values(pair.verifiedBy))]
const checkerText = checkers.length > 1 ? `${checkers.slice(0, -1).join(', ')} and ${checkers.at(-1)}` : checkers[0]

const fromMore = pagePairs.filter((p) => p.from === pair.from && p.to !== pair.to).slice(0, 14)
const toMore = pagePairs.filter((p) => p.to === pair.to && p.from !== pair.from).slice(0, 14)

const addon = pair.addon
const list = (xs: readonly string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}` : xs[0])
const manual = addon?.manualOn ?? []
const allManual = manual.length === 3
const title = `${F} to ${T} converter: free, offline, nothing uploaded | Asteria`
const description = addon
  ? `Convert ${F} to ${T} on Mac, Windows or Linux with Asteria, a free app that works on your own computer. It uses ${addon.name}, a free add-on Asteria installs with one click. Nothing is uploaded.`
  : `Convert ${F} to ${T} on Mac, Windows or Linux with Asteria, a free app that works on your own computer. Built in, works offline, and nothing is uploaded.`

const typedIsName = pair.typed === pair.skill.name.toLowerCase()
const paramExample = skill?.param && skill.aliases.includes(pair.to) && /^\d/.test(skill.param.default) ? `${pair.to} ${skill.param.default}` : null

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Asteria', item: 'https://asteria.trevorrosato.com/' },
    { '@type': 'ListItem', position: 2, name: 'Conversions', item: 'https://asteria.trevorrosato.com/convert' },
    { '@type': 'ListItem', position: 3, name: `${F} to ${T}`, item: `https://asteria.trevorrosato.com/convert/${pair.slug}` },
  ],
}
---

<Base title={title} description={description} path={`/convert/${pair.slug}`} jsonld={jsonld}>
  <article class="pairpage">
    <div class="wrap head">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/convert">Conversions</a> <span aria-hidden="true">/</span> {pair.family}</nav>
      <h1>{F} to {T}</h1>
      <p class="lede">
        Convert files from {pair.fromName} to {pair.toName} on your own Mac, Windows or Linux computer. Asteria is free, works
        offline, and never uploads your files.
      </p>
    </div>

    <div class="stage" aria-hidden="true">
      <div class="side before">
        <FileGlyph kind="outline" ext={pair.from} width={112} />
        <span class="cap">{pair.fromName}</span>
      </div>
      <div class="beam"><i></i></div>
      <div class="side after">
        <FileGlyph kind="paper" ext={pair.to} width={112} />
        <span class="cap">{pair.toName}</span>
      </div>
    </div>

    <div class="wrap body">
      <section aria-labelledby="how">
        <h2 id="how">How to do it</h2>
        <ol class="steps">
          <li><a href="/#download">Download Asteria</a> and open it. It's free and needs no account.</li>
          <li>Drop your {F} files onto its window, or press <kbd>⌘O</kbd> (<kbd>Ctrl O</kbd> on Windows) to choose them. A whole folder's worth is fine.</li>
          <li>
            Type <span class="typed">{pair.typed}</span>
            {typedIsName ? 'and press Enter.' : <>and pick <strong>{pair.skill.name}</strong>.</>}
            {skill?.description && <span class="aside"> {skill.description}.</span>}
          </li>
          {
            addon && (
              <li>
                {allManual
                  ? `The first time, Asteria tells you it needs ${addon.name}, a free program from ${addon.publisher}, and opens its official download page. Install it from there and Asteria finds it.`
                  : `The first time, Asteria asks to download ${addon.name}, a free add-on from ${addon.publisher} (${addon.license}). It shows the download size before you say yes, and needs no administrator password.${manual.length ? ` On ${list(manual)}, it opens ${addon.name}'s official download page instead, and finds it once it is installed.` : ''}`}
              </li>
            )
          }
          <li>
            Press <kbd>⌘↵</kbd> (<kbd>Ctrl ↵</kbd> on Windows) to save. The {T} files appear next to the originals, which stay exactly as they
            were.
          </li>
        </ol>
        {
          skill?.param && (
            <p class="param">
              {skill.param.label}: {skill.param.hint.replace(/ · /g, ', ')}.
              {paramExample && (
                <>
                  {' '}
                  Add it after the name, like <span class="typed">{paramExample}</span>.
                </>
              )}
            </p>
          )
        }
      </section>

      <section aria-labelledby="needs">
        <h2 id="needs">What it needs</h2>
        {
          addon ? (
            <p>
              {F} to {T} uses <a href={addon.homepage}>{addon.name}</a>, a free program for {addon.unlocks.toLowerCase()}.{' '}
              {allManual
                ? `Asteria doesn't bundle it. It only comes as an installer, so Asteria points you to the official download page and uses it once it is installed.`
                : `Asteria doesn't bundle it. The first time you need it, Asteria offers to download it from its official release, checks the download against a pinned checksum, and keeps it in its own folder, where Settings can remove it again.`}
              {' '}If {addon.name} is already on your computer, Asteria uses that copy.
            </p>
          ) : (
            <p>Nothing. This conversion is built into Asteria, so it works the moment the app is open, even offline.</p>
          )
        }
      </section>

      <section aria-labelledby="tested">
        <h2 id="tested">How it was tested</h2>
        <p>
          A real {F} file was converted on {platformText}, and the {T} that came out was checked with {checkerText}, a separate
          program, to make sure it opens and is what it says it is.
        </p>
      </section>

      {
        others.length > 0 && (
          <section aria-labelledby="also">
            <h2 id="also">Other ways to get there</h2>
            <p>
              These skills also take a {F} and give back a {T}: {others.map((o, i) => (
                <>
                  {i > 0 && (i === others.length - 1 ? ' and ' : ', ')}
                  <strong>{o.name}</strong>
                </>
              ))}.
            </p>
          </section>
        )
      }

      <div class="get">
        <DownloadButton direct />
        <p>Free for Mac, Windows and Linux. <a href="/#download">Other systems and first-launch help</a></p>
      </div>

      {
        (fromMore.length > 0 || toMore.length > 0) && (
          <section class="more" aria-label="Related conversions">
            {fromMore.length > 0 && (
              <div>
                <h2>More from {F}</h2>
                <ul>
                  {fromMore.map((p) => (
                    <li>
                      <a href={`/convert/${p.slug}`}>
                        {F} to {p.to.toUpperCase()}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {toMore.length > 0 && (
              <div>
                <h2>More to {T}</h2>
                <ul>
                  {toMore.map((p) => (
                    <li>
                      <a href={`/convert/${p.slug}`}>
                        {p.from.toUpperCase()} to {T}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        )
      }
    </div>
  </article>
</Base>

<style>
  .pairpage {
    padding-top: clamp(24px, 6vh, 72px);
  }
  .head {
    max-width: calc(760px + 2 * var(--gutter));
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 18px;
  }
  .crumbs {
    color: var(--muted);
    font-size: 14px;
  }
  .crumbs a {
    color: var(--ink-2);
  }
  .head .lede {
    max-width: 48ch;
  }
  .stage {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(28px, 8vw, 96px);
    max-width: 640px;
    margin: clamp(40px, 6vh, 64px) auto;
    padding-inline: var(--gutter);
  }
  .side {
    display: grid;
    justify-items: center;
    gap: 14px;
    text-align: center;
  }
  .cap {
    color: var(--ink-2);
    font-size: 14px;
  }
  .stage .beam {
    height: 200px;
  }
  .after :global(.glyph svg) {
    filter: drop-shadow(0 14px 18px rgb(0 0 0 / 0.5));
  }
  .body {
    max-width: calc(680px + 2 * var(--gutter));
    display: grid;
    gap: 44px;
  }
  .body h2 {
    font-size: 1.5rem;
    font-weight: 300;
    margin-bottom: 14px;
  }
  .body p,
  .steps {
    color: var(--ink-2);
  }
  .body strong {
    color: var(--ink);
    font-weight: 450;
  }
  .steps {
    margin: 0;
    padding-left: 1.4em;
    display: grid;
    gap: 12px;
  }
  .steps li {
    color: var(--ink);
  }
  .steps li::marker {
    color: var(--muted);
  }
  .aside {
    color: var(--muted);
  }
  .param {
    margin-top: 16px;
    font-size: 15px;
  }
  .get {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    padding: 28px 0;
    border-block: 1px solid var(--line);
  }
  .get p {
    font-size: 14px;
    color: var(--muted);
  }
  .get a:not(.btn) {
    color: var(--ink-2);
  }
  .more {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .more h2 {
    font-size: 1.1rem;
    font-weight: 400;
  }
  .more ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    font-size: 15px;
  }
  .more a {
    color: var(--ink-2);
  }
  @media (max-width: 560px) {
    .more {
      grid-template-columns: 1fr;
    }
    .stage :global(.glyph) {
      --gw: 84px !important;
    }
    .stage .beam {
      height: 160px;
    }
  }
</style>

<script>
  import { wireDownloads } from '../../scripts/os'
  wireDownloads()
</script>
