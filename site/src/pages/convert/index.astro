---
import Base from '../../layouts/Base.astro'
import Finder from '../../components/Finder.astro'
import { summary } from '../../lib/data'

const description = `Every file conversion Asteria has tested: ${summary.conversionPairs} of them, from ${summary.fileTypesRead} kinds of file. Each says whether it is built in or needs a free add-on.`
---

<Base title="Every conversion Asteria can do | Asteria" description={description} path="/convert">
  <Finder show="all" headingLevel="h1" id="all" />
</Base>
