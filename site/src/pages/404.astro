---
import Base from '../layouts/Base.astro'
import FileGlyph from '../components/FileGlyph.astro'
---

<Base title="Not found | Asteria" description="This page didn't make it through." path="/404" noindex>
  <section class="lost">
    <div class="stage" aria-hidden="true">
      <div class="side">
        <FileGlyph kind="outline" ext="404" width={120} />
      </div>
      <div class="beam"><i></i></div>
      <div class="side empty"></div>
    </div>
    <div class="wrap copy">
      <h1>This page didn't make it through.</h1>
      <p class="lede">There's nothing at this address. It may have moved, or the link has a typo.</p>
      <p class="links"><a class="btn primary" href="/">Go to the home page</a> <a class="btn" href="/convert">Find a conversion</a></p>
    </div>
  </section>
</Base>

<style>
  .lost {
    padding-block: clamp(40px, 10vh, 120px) 0;
  }
  .stage {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(28px, 8vw, 96px);
    max-width: 560px;
    margin: 0 auto;
    padding-inline: var(--gutter);
  }
  .side {
    display: grid;
    justify-items: end;
  }
  /* it got as far as the line and stopped */
  .side :global(.glyph) {
    margin-right: -14px;
  }
  .beam {
    height: 200px;
  }
  .beam::after {
    opacity: 0.6;
  }
  .copy {
    margin-top: 48px;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 18px;
  }
  h1 {
    font-size: clamp(2.2rem, 1.4rem + 3vw, 3.6rem);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 12px;
  }
</style>
